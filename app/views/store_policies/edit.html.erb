<main class="rc-page rc-purchase-editor">
  <nav class="rc-breadcrumb" aria-label="<%= t('ui.breadcrumbs') %>">
    <%= link_to "Store Policies", store_policies_path %>
    <span>/</span><span>Edit</span>
  </nav>
  <div class="rc-page-heading">
    <div>
      <span class="rc-kicker">RETURN RULES</span>
      <h1>Edit Store Policy</h1>
      <p class="rc-policy-context">Existing purchase deadlines stay unchanged. Changing a purchase's date or selected policy uses the current return window.</p>
    </div>
  </div>
  <div class="rc-policy-form-shell">
    <section class="card rc-form-panel" aria-label="Edit store policy">
      <%= render "form" %>
    </section>
    <p class="rc-editor-navigation"><%= link_to "Back to Store Policies", store_policies_path %></p>
  </div>
</main>
