<% content_for :purchase_editor_page, "true" %>
<%= turbo_frame_tag "purchase_editor", target: (turbo_frame_request? ? nil : "_top") do %>
<%# 1. Backend handoff: the new action must set @purchase = Current.user.purchases.build. %>
<main class="rc-page rc-purchase-editor">
  <nav class="rc-breadcrumb" aria-label="<%= t('ui.breadcrumbs') %>"><%= link_to t("ui.dashboard"), dashboard_path %><span>/</span><span><%= t("ui.add") %></span></nav>
  <div class="rc-page-heading"><div><span class="rc-kicker"><%= t("ui.new_kicker") %></span><h1><%= @sample_purchase ? "Edit Sample Purchase" : t("ui.add_purchase") %></h1><p><%= t("ui.new_purchase_intro") %></p></div></div>
  <%= tag.div(flash[:notice], class: "rc-alert", role: "status") if flash[:notice] %>
  <% if @sample_purchase %>
    <p class="rc-alert" role="note">Editing a demo template. Enter your own store and return-by date, then save to add this purchase to your account.</p>
  <% end %>
  <% if @purchase %>
    <%= render "purchases/form", purchase: @purchase %>
  <% else %>
    <div class="card rc-empty" role="alert"><%= t("ui.new_missing") %></div>
  <% end %>
  <p class="rc-editor-navigation"><%= link_to "Back to Dashboard", dashboard_path %> · <%= link_to "View History", history_path %></p>
</main>
<% end %>
