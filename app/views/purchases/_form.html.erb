<%# 1. Prepare variables using only the existing Purchase and StorePolicy fields. %>
<% policies = Current.user.store_policies.order(:store_name) %>
<% preview = local_assigns.fetch(:preview, false) %>
<% id_prefix = preview ? "rc-preview" : "rc" %>

<%= form_with(model: purchase, class: "rc-purchase-form", local: true, **(preview ? { url: "#", method: :get, namespace: "rc-preview", data: { action: "submit->rc-purchase-preview#pending", turbo: false } } : {})) do |form| %>
  <%= hidden_field_tag :sample, @sample_purchase.item_name if @sample_purchase %>
  <% if purchase.errors.any? %>
    <div class="rc-form-errors" role="alert" aria-live="polite">
      <strong>Please correct the following:</strong>
      <ul>
        <% purchase.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="card rc-form-panel" aria-labelledby="<%= id_prefix %>-purchase-details">
    <div class="rc-form-panel-head">
      <span class="rc-step-num">01</span>
      <div><h2 id="<%= id_prefix %>-purchase-details"><%= t("ui.purchase_details") %></h2><p><%= t("ui.purchase_details_hint") %></p></div>
    </div>
    <div class="rc-field-grid">
      <div class="rc-form-field rc-field-wide">
        <%= form.label :item_name, "Item Name", class: "form-label" %>
        <%= form.text_field :item_name, class: "form-control", placeholder: t("ui.example_item"), required: true, maxlength: 255, autocomplete: "off" %>
      </div>
      <div class="rc-form-field">
        <%= form.label :price, "Price", class: "form-label" %>
        <div class="rc-input-prefix"><span aria-hidden="true">$</span><%= form.number_field :price, class: "form-control", min: "0.01", step: "0.01", placeholder: "99.99", required: true %></div>
      </div>
      <div class="rc-form-field">
        <%= form.label :purchase_date, "Purchase Date", class: "form-label" %>
        <%= form.date_field :purchase_date, class: "form-control", required: true %>
      </div>
    </div>
  </section>

  <section class="card rc-form-panel" aria-labelledby="<%= id_prefix %>-store-policy">
    <div class="rc-form-panel-head">
      <span class="rc-step-num">02</span>
      <div><h2 id="<%= id_prefix %>-store-policy"><%= t("ui.store_policy") %></h2><p><%= t("ui.store_policy_hint") %></p></div>
    </div>
    <% if policies.empty? %>
      <p>Create a store return policy before adding your first purchase.</p>
    <% else %>
      <div class="rc-form-field">
        <%= form.label :store_policy_id, "Store Policy", class: "form-label" %>
        <%= form.collection_select :store_policy_id, policies, :id, :store_name,
              { prompt: "Select a store policy" }, { class: "form-select", required: true } %>
      </div>
    <% end %>
    <p><%= link_to "Create Store Policy", new_store_policy_path(sample: @sample_purchase&.item_name), class: "rc-card-link" %></p>
    <p class="rc-deadline-note"><strong><%= t("ui.deadline_label") %></strong><%= t("ui.deadline_hint") %></p>
  </section>

  <%# 4. Use Purchase::STATUSES without defining additional status values. %>
  <% if purchase.persisted? || preview %>
    <section class="card rc-form-panel" aria-labelledby="<%= id_prefix %>-status-heading" <%= 'data-rc-purchase-preview-target=statusSection hidden' if preview %>>
      <div class="rc-form-panel-head"><span class="rc-step-num">03</span><div><h2 id="<%= id_prefix %>-status-heading"><%= t("ui.current_status") %></h2><p><%= t("ui.status_hint") %></p></div></div>
      <div class="rc-form-field">
        <%= form.label :status, "Status", class: "form-label" %>
        <%= form.select :status, purchase_status_options, { include_blank: false }, { class: "form-select" } %>
      </div>
      <p class="rc-field-hint"><%= t("ui.current_deadline") %><%= purchase.return_by ? l(purchase.return_by, format: :long) : t("ui.calculated_later") %></p>
    </section>
  <% else %>
    <%= form.hidden_field :status, value: "active" %>
  <% end %>
  <div class="rc-form-footer">
    <% if preview %>
      <button type="button" class="rc-btn rc-btn-outline" data-action="rc-purchase-preview#close"><%= t("ui.cancel") %></button>
    <% else %>
      <%= link_to t("ui.cancel"), dashboard_path, class: "rc-btn rc-btn-outline", data: { modal_dismiss: true } %>
    <% end %>
    <%= form.submit(purchase.persisted? ? "Save Purchase" : "Add Purchase", class: "rc-btn rc-btn-primary", disabled: policies.empty?, data: (preview ? { rc_purchase_preview_target: "submitButton" } : {})) %>
  </div>
<% end %>
