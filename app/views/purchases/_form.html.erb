<%# 1. Prepare variables using only the existing Purchase and StorePolicy fields. %>
<% policies = Current.user.store_policies.order(:store_name, :window_days, :id) %>
<% preview = local_assigns.fetch(:preview, false) %>
<% id_prefix = preview ? "rc-preview" : "rc" %>
<% item_error_id = "#{id_prefix}-item-name-errors" %>
<% price_error_id = "#{id_prefix}-price-errors" %>
<% date_error_id = "#{id_prefix}-purchase-date-errors" %>
<% policy_error_id = "#{id_prefix}-store-policy-errors" %>
<% status_error_id = "#{id_prefix}-status-errors" %>
<% policy_errors = (purchase.errors.full_messages_for(:store_policy) + purchase.errors.full_messages_for(:store_policy_id)).uniq %>

<%# The live summary only reports what Save would store; nothing is saved until the form is submitted. %>
<% form_data = preview ? { action: "submit->rc-purchase-preview#pending", turbo: false } : {
  controller: "rc-purchase-feedback",
  action: "input->rc-purchase-feedback#refresh change->rc-purchase-feedback#refresh focusout->rc-purchase-feedback#refresh",
  rc_purchase_feedback_today_value: Date.current.iso8601,
  rc_purchase_feedback_saved_date_value: purchase.persisted? ? purchase.purchase_date_in_database&.iso8601 : nil,
  rc_purchase_feedback_saved_policy_value: purchase.persisted? ? purchase.store_policy_id_in_database : nil,
  rc_purchase_feedback_saved_return_by_value: purchase.persisted? ? purchase.return_by_in_database&.iso8601 : nil
} %>

<%= form_with(model: purchase, class: "rc-purchase-form", local: true, data: form_data, **(preview ? { url: "#", method: :get, namespace: "rc-preview" } : {})) do |form| %>
  <% unless preview %>
    <%# Keep Enter submitting the purchase rather than the policy handoff button. %>
    <button type="submit" hidden <%= "disabled" if policies.empty? %>></button>
  <% end %>
  <%= hidden_field_tag :sample, @sample_purchase.item_name if @sample_purchase %>
  <%= hidden_field_tag :purchase_id, purchase.id if purchase.persisted? %>
  <% if purchase.errors.any? %>
    <div class="rc-form-errors" role="alert" aria-live="polite" tabindex="-1" data-controller="rc-error-focus">
      <strong>Please correct the following:</strong>
      <ul>
        <% purchase.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="card rc-form-panel" aria-labelledby="<%= id_prefix %>-purchase-details">
    <div class="rc-form-panel-head">
      <span class="rc-step-num">01</span>
      <div><h2 id="<%= id_prefix %>-purchase-details"><%= t("ui.purchase_details") %></h2><p><%= t("ui.purchase_details_hint") %></p></div>
    </div>
    <div class="rc-field-grid">
      <div class="rc-form-field rc-field-wide">
        <%= form.label :item_name, "Item Name", class: "form-label" %>
        <%= form.text_field :item_name, class: "form-control", placeholder: t("ui.example_item"), required: true, maxlength: 255, autocomplete: "off",
              data: { rc_purchase_feedback_target: "itemName" },
              aria: purchase.errors[:item_name].any? ? { invalid: true, describedby: item_error_id } : {} %>
        <% if purchase.errors[:item_name].any? %>
          <ul id="<%= item_error_id %>" class="auth-field-errors">
            <% purchase.errors.full_messages_for(:item_name).each do |message| %><li><%= message %></li><% end %>
          </ul>
        <% end %>
        <p id="<%= id_prefix %>-item-name-live" class="rc-live-error" aria-live="polite" data-rc-purchase-feedback-target="error" data-field="item_name"></p>
      </div>
      <div class="rc-form-field">
        <%= form.label :price, "Price", class: "form-label" %>
        <div class="rc-input-prefix"><span aria-hidden="true">$</span><%= form.number_field :price, class: "form-control", min: "0", step: "0.01", placeholder: "0.00",
              data: { rc_purchase_feedback_target: "price" },
              aria: purchase.errors[:price].any? ? { invalid: true, describedby: price_error_id } : {} %></div>
        <% if purchase.errors[:price].any? %>
          <ul id="<%= price_error_id %>" class="auth-field-errors">
            <% purchase.errors.full_messages_for(:price).each do |message| %><li><%= message %></li><% end %>
          </ul>
        <% end %>
        <p id="<%= id_prefix %>-price-live" class="rc-live-error" aria-live="polite" data-rc-purchase-feedback-target="error" data-field="price"></p>
      </div>
      <div class="rc-form-field">
        <%= form.label :purchase_date, "Purchase Date", class: "form-label" %>
        <%= form.date_field :purchase_date, class: "form-control", required: true,
              data: { rc_purchase_feedback_target: "purchaseDate" },
              aria: purchase.errors[:purchase_date].any? ? { invalid: true, describedby: date_error_id } : {} %>
        <p class="rc-form-helper">Choose the date shown on your purchase receipt.</p>
        <% if purchase.errors[:purchase_date].any? %>
          <ul id="<%= date_error_id %>" class="auth-field-errors">
            <% purchase.errors.full_messages_for(:purchase_date).each do |message| %><li><%= message %></li><% end %>
          </ul>
        <% end %>
        <p id="<%= id_prefix %>-purchase-date-live" class="rc-live-error" aria-live="polite" data-rc-purchase-feedback-target="error" data-field="purchase_date"></p>
      </div>
    </div>
  </section>

  <section class="card rc-form-panel" aria-labelledby="<%= id_prefix %>-store-policy">
    <div class="rc-form-panel-head">
      <span class="rc-step-num">02</span>
      <div><h2 id="<%= id_prefix %>-store-policy"><%= t("ui.store_policy") %></h2><p><%= t("ui.store_policy_hint") %></p></div>
    </div>
    <% if policies.empty? %>
      <p class="rc-policy-help" role="status">Create a store return policy before adding your first purchase.</p>
    <% else %>
      <div class="rc-form-field">
        <%= form.label :store_policy_id, "Store Policy", class: "form-label" %>
        <%= form.select :store_policy_id, policies.map { |policy| [ policy.label, policy.id, { data: { window_days: policy.window_days } } ] },
              { prompt: "Select a store policy" }, { class: "form-select", required: true,
                data: { rc_purchase_feedback_target: "policy" },
                aria: policy_errors.any? ? { invalid: true, describedby: policy_error_id } : {} } %>
        <p class="rc-form-helper">Select the store whose return window applies to this purchase.</p>
        <p id="<%= id_prefix %>-store-policy-id-live" class="rc-live-error" aria-live="polite" data-rc-purchase-feedback-target="error" data-field="store_policy_id"></p>
      </div>
    <% end %>
    <% if policy_errors.any? %>
      <ul id="<%= policy_error_id %>" class="auth-field-errors">
        <% policy_errors.each do |message| %><li><%= message %></li><% end %>
      </ul>
    <% end %>
    <p class="rc-form-helper">
      <% unless preview %>
        <% handoff_method = purchase.persisted? ? "patch" : "post" %>
        <%= button_tag "Create Store Policy", type: "submit", class: "rc-card-link", formaction: from_purchase_store_policies_path,
              formnovalidate: true, data: { turbo_frame: "purchase_editor" }, name: "authenticity_token",
              value: form_authenticity_token(form_options: { action: from_purchase_store_policies_path, method: handoff_method }) %>
      <% else %>
        <%= link_to "Create Store Policy", new_store_policy_path(origin: "purchase", sample: @sample_purchase&.item_name), class: "rc-card-link" %>
      <% end %>
      if your store is missing.
    </p>
    <p class="rc-deadline-note"><strong><%= t("ui.deadline_label") %></strong><%= t("ui.deadline_hint") %></p>
  </section>

  <%# 4. Use Purchase::STATUSES without defining additional status values. %>
    <section class="card rc-form-panel" aria-labelledby="<%= id_prefix %>-status-heading" <%= 'data-rc-purchase-preview-target=statusSection hidden' if preview %>>
      <div class="rc-form-panel-head"><span class="rc-step-num">03</span><div><h2 id="<%= id_prefix %>-status-heading"><%= t("ui.current_status") %></h2><p><%= t("ui.status_hint") %></p></div></div>
      <div class="rc-form-field">
        <%= form.label :status, "Status", class: "form-label" %>
        <%= form.select :status, purchase_status_options, { prompt: "Select a status" }, { class: "form-select", required: true, data: { rc_purchase_feedback_target: "status" },
              aria: { invalid: purchase.errors[:status].any?,
                describedby: [ "purchase-status-hint", (status_error_id if purchase.errors[:status].any?) ].compact.join(" ") } } %>
        <% if purchase.errors[:status].any? %>
          <ul id="<%= status_error_id %>" class="auth-field-errors">
            <% purchase.errors.full_messages_for(:status).each do |message| %><li><%= message %></li><% end %>
          </ul>
        <% end %>
      </div>
      <p id="purchase-status-hint" class="rc-field-hint">Active means you haven't decided whether to keep or return this purchase.</p>
      <p class="rc-field-hint"><%= t("ui.current_deadline") %><%= purchase.return_by ? l(purchase.return_by, format: :long) : t("ui.calculated_later") %></p>
    </section>
  <% unless preview %>
    <section class="card rc-form-panel rc-save-summary" aria-labelledby="<%= id_prefix %>-save-summary">
      <h2 id="<%= id_prefix %>-save-summary" class="rc-save-summary-title">What will be saved</h2>
      <dl class="rc-save-summary-list">
        <dt>Store policy</dt><dd data-rc-purchase-feedback-target="store"><%= purchase.store_policy&.label || "Choose a store policy" %></dd>
        <dt>Price</dt><dd data-rc-purchase-feedback-target="savedPrice"><%= number_to_currency(purchase.price || 0) %></dd>
        <dt>Return by</dt><dd data-rc-purchase-feedback-target="returnBy"><%= purchase.return_by ? l(purchase.return_by, format: :long) : "Choose a purchase date and store policy" %></dd>
        <dt data-rc-purchase-feedback-target="daysLeftLabel">Days left</dt><dd data-rc-purchase-feedback-target="daysLeft"><%= purchase.return_by ? purchase.days_left : "—" %></dd>
      </dl>
      <p class="rc-field-hint">Nothing is saved until you choose <%= purchase.persisted? ? "Save Purchase" : "Add Purchase" %>.</p>
    </section>
  <% end %>
  <div class="rc-form-footer">
    <% if preview %>
      <button type="button" class="rc-btn rc-btn-outline" data-action="rc-purchase-preview#close"><%= t("ui.cancel") %></button>
    <% else %>
      <%= link_to t("ui.cancel"), dashboard_path, class: "rc-btn rc-btn-outline", data: { modal_dismiss: true } %>
    <% end %>
    <%= form.submit(purchase.persisted? ? "Save Purchase" : "Add Purchase", class: "rc-btn rc-btn-primary", disabled: policies.empty?, data: (preview ? { rc_purchase_preview_target: "submitButton" } : {})) %>
  </div>
<% end %>
