<% content_for :purchase_editor_page, "true" %>
<%= turbo_frame_tag "purchase_editor" do %>
<%# 1. Backend handoff: the edit action must load @purchase through Current.user.purchases.find(params[:id]). %>
<main class="rc-page rc-purchase-editor">
  <nav class="rc-breadcrumb" aria-label="<%= t('ui.breadcrumbs') %>"><%= link_to t("ui.dashboard"), dashboard_path %><span>/</span><span><%= t("ui.edit_heading") %></span></nav>
  <div class="rc-page-heading"><div><span class="rc-kicker"><%= t("ui.edit_kicker") %></span><h1><%= t("ui.edit_purchase") %></h1><p><%= t("ui.edit_purchase_intro") %></p></div></div>
  <% if @purchase %>
    <%= render "purchases/form", purchase: @purchase %>
  <% else %>
    <div class="card rc-empty" role="alert"><%= t("ui.edit_missing") %></div>
  <% end %>
  <p class="rc-editor-navigation"><%= link_to "Back to Dashboard", dashboard_path %> · <%= link_to "View History", history_path %></p>
</main>
<% end %>
