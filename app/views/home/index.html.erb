<main class="auth-page auth-landing">
  <% if notice.present? %>
    <div class="auth-notice" role="status"><%= notice %></div>
  <% end %>

  <h1>ReturnClock</h1>
  <p>Never miss a return window again.</p>

  <div class="auth-actions">
    <%= link_to "Create Account", sign_up_path, class: "auth-button" %>
    <%= link_to "Sign In", new_session_path, class: "auth-button" %>
  </div>
</main>
