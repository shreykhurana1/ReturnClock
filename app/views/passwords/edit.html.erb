<h1><%= t("ui.update_password") %></h1>

<%= tag.div(localized_flash(flash[:alert]), style: "color:red") if flash[:alert] %>
<% if @user.errors.any? %>
  <div class="auth-error" role="alert">
    <p>Please correct the following:</p>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: password_path(params[:token]), method: :put, data: { controller: "rc-error-focus" } do |form| %>
  <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: t("ui.enter_password"), maxlength: 72,
        aria: @user.errors[:password].any? ? { invalid: true, describedby: "reset-password-errors" } : {} %><br>
  <% if @user.errors[:password].any? %>
    <ul id="reset-password-errors" class="auth-field-errors">
      <% @user.errors.full_messages_for(:password).each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t("ui.repeat_password"), maxlength: 72,
        aria: @user.errors[:password_confirmation].any? ? { invalid: true, describedby: "reset-password-confirmation-errors" } : {} %><br>
  <% if @user.errors[:password_confirmation].any? %>
    <ul id="reset-password-confirmation-errors" class="auth-field-errors">
      <% @user.errors.full_messages_for(:password_confirmation).each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>
  <%= form.submit t("ui.save"), data: { turbo_submits_with: "Saving…" } %>
<% end %>
