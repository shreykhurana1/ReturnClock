<main class="rc-page rc-dashboard">
  <% sample_mode = !Current.user.purchases.exists? %>
  <% sample_records = sample_mode ? sample_purchases(history: false) : [] %>
  <% visible_sample_records = sample_records.select { |purchase| @filter_days.nil? || purchase.return_by.between?(Date.current, Date.current + @filter_days) } %>
  <% purchases = sample_mode ? visible_sample_records : @purchases %>
  <% stats = if sample_mode
       { total: sample_records.size,
         due_week: sample_records.count { |purchase| purchase.status == "active" && purchase.days_left&.between?(0, 7) },
         money_at_risk: sample_records.select { |purchase| Purchase::OPEN_STATUSES.include?(purchase.status) }.sum(&:price),
         savings: sample_purchases(history: true).select { |purchase| purchase.status == "refunded" }.sum(&:price) }
     else
       @stats
     end %>
  <% dashboard_filters = { "all" => "All", "week" => "7 days", "two_weeks" => "14 days", "month" => "30 days" } %>

  <div class="rc-page-heading">
    <div>
      <span class="rc-kicker"><%= t("ui.purchases_kicker") %></span>
      <h1><%= t("ui.dashboard") %></h1>
      <p><%= t("ui.dashboard_intro") %></p>
    </div>
    <% if respond_to?(:new_purchase_path) %>
      <%= link_to t("ui.add_purchase_button"), new_purchase_path, class: "rc-btn rc-btn-primary", data: { turbo_frame: "purchase_editor" } %>
    <% else %>
      <%= link_to t("ui.add_purchase_button"), coming_soon_add_purchase_path, class: "rc-btn rc-btn-primary", data: { action: "rc-purchase-preview#new" } %>
    <% end %>
  </div>

  <%= tag.div(localized_flash(flash[:notice]), class: "rc-alert", role: "status") if flash[:notice] %>
  <%= tag.div(flash[:alert], class: "auth-error", role: "alert") if flash[:alert] %>
  <%= render "shared/sample_purchases" if sample_mode %>

  <section class="rc-section" id="dashboard-purchases" aria-label="Actionable purchases">
    <div class="rc-list-toolbar">
      <nav class="rc-filter-row" aria-label="Filter by return deadline">
        <% dashboard_filters.each do |filter, label| %>
          <%= link_to label, dashboard_path(filter: filter),
                class: "rc-filter #{'active' if @filter == filter}",
                aria: { current: ("page" if @filter == filter) },
                data: { dashboard_filter: filter } %>
        <% end %>
      </nav>
      <% if !sample_mode && @total_pages > 1 %>
        <%= render "shared/pagination", page: @page, total_pages: @total_pages, inline: true,
              build_path: ->(page_number) { dashboard_path(filter: @filter, page: page_number) } %>
      <% end %>
    </div>

    <% if purchases.any? %>
      <div class="purchase-grid rc-card-grid">
        <%= render partial: "shared/purchase_card", collection: purchases, as: :purchase %>
      </div>
    <% else %>
      <div class="card rc-empty">
        <span class="rc-empty-icon" aria-hidden="true">▦</span>
        <h3><%= @filter == "all" ? t("ui.dashboard_empty") : "No purchases match this deadline filter." %></h3>
        <p><%= @filter == "all" ? t("ui.dashboard_empty_detail") : "Try another deadline range or view all purchases." %></p>
      </div>
    <% end %>
  </section>

  <%= render "dashboard/stats", stats: stats %>
</main>
