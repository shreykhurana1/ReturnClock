<main class="rc-page rc-history">
  <% sample_mode = !Current.user.purchases.exists? %>
  <% sample_records = sample_mode ? sample_purchases(history: true) : [] %>
  <% sample_matches = case @filter
     when "refunded" then sample_records.select { |purchase| purchase.status == "refunded" }
     when "keeping" then sample_records.select { |purchase| purchase.status == "keeping" }
     when "expired" then sample_records.select { |purchase| purchase.status == "active" && purchase.days_left&.negative? }
     else sample_records
     end %>
  <% purchases = sample_mode ? sample_matches : @purchases %>
  <% stats = if sample_mode
       { total: sample_records.size,
         refunded: sample_records.count { |purchase| purchase.status == "refunded" },
         keeping: sample_records.count { |purchase| purchase.status == "keeping" },
         expired: sample_records.count { |purchase| purchase.status == "active" && purchase.days_left&.negative? } }
     else
       @stats
     end %>
  <div class="rc-page-heading">
    <div>
      <span class="rc-kicker"><%= t("ui.history_kicker") %></span>
      <h1><%= t("ui.history") %></h1>
      <p><%= t("ui.history_intro") %></p>
    </div>
  </div>
  <%= tag.div(localized_flash(flash[:notice]), class: "rc-alert", role: "status") if flash[:notice] %>
  <%= tag.div(flash[:alert], class: "auth-error", role: "alert") if flash[:alert] %>
  <%= render "shared/sample_purchases" if sample_mode %>

  <section class="rc-section" aria-label="History records">
    <div class="rc-list-toolbar">
      <nav class="rc-filter-row" aria-label="<%= t('ui.history_filter') %>">
        <% { "all" => t("ui.all"), "refunded" => t("ui.refunded"), "keeping" => t("ui.keeping"), "expired" => t("ui.expired") }.each do |filter, label| %>
          <%= link_to label, history_path(filter: filter),
                class: "rc-filter #{'active' if @filter == filter}",
                aria: { current: ("page" if @filter == filter) },
                data: { history_filter: filter } %>
        <% end %>
      </nav>
      <% if !sample_mode && @total_pages > 1 %>
        <%= render "shared/pagination", page: @page, total_pages: @total_pages, inline: true, label: "History pages",
              build_path: ->(page_number) { history_path(filter: @filter, page: page_number) } %>
      <% end %>
    </div>

    <% if purchases.any? %>
      <div id="history-records" class="purchase-grid rc-card-grid rc-history-grid">
        <%= render partial: "shared/purchase_card", collection: purchases, as: :purchase %>
      </div>
    <% else %>
      <div id="history-records" class="card rc-empty">
        <span class="rc-empty-icon" aria-hidden="true">◷</span>
        <h3><%= @filter == "all" ? t("ui.history_empty") : t("ui.history_filter_empty") %></h3>
        <p><%= @filter == "all" ? t("ui.history_empty_detail") : t("ui.history_all_detail") %></p>
      </div>
    <% end %>
  </section>

  <%= render "history/stats", stats: stats %>
</main>
