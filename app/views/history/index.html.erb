<main class="rc-page rc-history" data-controller="rc-purchase-filter">
  <% sample_mode = !Current.user.purchases.exists? %>
  <% purchases = sample_mode ? sample_purchases(history: true) : @purchases %>

  <div class="rc-page-heading">
    <div>
      <span class="rc-kicker"><%= t("ui.history_kicker") %></span>
      <h1><%= t("ui.history") %></h1>
      <p><%= t("ui.history_intro") %></p>
    </div>
  </div>
  <%= tag.div(localized_flash(flash[:notice]), class: "rc-alert", role: "status") if flash[:notice] %>
  <%= render "shared/sample_purchases" if sample_mode %>

  <div class="rc-stat-grid" role="group" aria-label="History overview">
    <div class="card rc-stat">
      <span class="rc-stat-title"><%= t("ui.history_total") %></span>
      <div><strong><%= purchases.size %></strong><small><%= t("ui.purchases_unit") %></small></div>
      <span class="rc-stat-detail"><%= t("ui.history_total_detail") %></span>
    </div>
    <div class="card rc-stat">
      <span class="rc-stat-title"><%= t("ui.refunded") %></span>
      <div><strong><%= purchases.count { |p| p.status == "refunded" } %></strong><small><%= t("ui.purchases_unit") %></small></div>
      <span class="rc-stat-detail"><%= t("ui.refunded_detail") %></span>
    </div>
    <div class="card rc-stat">
      <span class="rc-stat-title"><%= t("ui.keeping") %></span>
      <div><strong><%= purchases.count { |p| p.status == "keeping" } %></strong><small><%= t("ui.purchases_unit") %></small></div>
      <span class="rc-stat-detail"><%= t("ui.keeping_detail") %></span>
    </div>
    <div class="card rc-stat rc-stat-quiet">
      <span class="rc-stat-title"><%= t("ui.expired") %></span>
      <div><strong><%= purchases.count { |p| p.status == "active" && p.days_left&.negative? } %></strong><small><%= t("ui.purchases_unit") %></small></div>
      <span class="rc-stat-detail"><%= t("ui.expired_detail") %></span>
    </div>
  </div>

  <section aria-labelledby="history-records-title">
    <div class="rc-section-heading rc-history-heading">
      <div>
        <h2 id="history-records-title"><%= t("ui.history_all_heading") %></h2>
        <p><%= t("ui.history_all_detail") %></p>
      </div>
      <span class="rc-small-count"><%= t("ui.record_count", count: purchases.size) %></span>
    </div>
    <div class="rc-filter-row" role="group" aria-label="<%= t('ui.history_filter') %>">
      <button type="button" class="rc-filter active" data-rc-purchase-filter-target="button" data-rc-purchase-filter-value="all" data-action="rc-purchase-filter#filter" aria-pressed="true" aria-controls="history-records"><%= t("ui.all") %></button>
      <button type="button" class="rc-filter" data-rc-purchase-filter-target="button" data-rc-purchase-filter-value="refunded" data-action="rc-purchase-filter#filter" aria-pressed="false" aria-controls="history-records"><%= t("ui.refunded") %></button>
      <button type="button" class="rc-filter" data-rc-purchase-filter-target="button" data-rc-purchase-filter-value="keeping" data-action="rc-purchase-filter#filter" aria-pressed="false" aria-controls="history-records"><%= t("ui.keeping") %></button>
      <button type="button" class="rc-filter" data-rc-purchase-filter-target="button" data-rc-purchase-filter-value="expired" data-action="rc-purchase-filter#filter" aria-pressed="false" aria-controls="history-records"><%= t("ui.expired") %></button>
    </div>
    <% if purchases.any? %>
      <div id="history-records" class="purchase-grid rc-card-grid rc-history-grid">
        <%= render partial: "shared/purchase_card", collection: purchases, as: :purchase %>
      </div>
      <p class="rc-empty-filter" data-rc-purchase-filter-target="empty" role="status" aria-live="polite" hidden><%= t("ui.history_filter_empty") %></p>
    <% else %>
      <div id="history-records" class="card rc-empty">
        <span class="rc-empty-icon" aria-hidden="true">◷</span>
        <h3><%= t("ui.history_empty") %></h3>
        <p><%= t("ui.history_empty_detail") %></p>
      </div>
    <% end %>
  </section>
</main>
