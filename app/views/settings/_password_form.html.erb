<h3><%= t("ui.change_password") %></h3>
<p class="rc-field-hint">Changing your password signs you out on all devices.</p>
<% if user.errors.any? %>
  <div class="auth-error" role="alert">
    <p>Please correct the fields below.</p>
    <% user.errors[:base].each do |message| %><p><%= message %></p><% end %>
  </div>
<% end %>

<%= form_with url: settings_password_path, scope: :user, method: :patch, local: true, class: "rc-purchase-form" do |form| %>
  <div class="rc-field-grid">
    <div class="rc-form-field rc-field-wide">
      <%= form.label :current_password, "Current Password", class: "form-label" %>
      <%= form.password_field :current_password, value: nil, required: true, autocomplete: "current-password", class: "form-control",
            aria: { invalid: user.errors[:current_password].any?, describedby: ("current-password-errors" if user.errors[:current_password].any?) } %>
      <% if user.errors[:current_password].any? %>
        <ul id="current-password-errors" class="auth-field-errors">
          <% user.errors[:current_password].each do |message| %><li><%= message %></li><% end %>
        </ul>
      <% end %>
    </div>
    <div class="rc-form-field">
      <%= form.label :password, "New Password", class: "form-label" %>
      <%= form.password_field :password, value: nil, required: true, minlength: 8, autocomplete: "new-password", class: "form-control",
            aria: { invalid: user.errors[:password].any?, describedby: [ "new-password-hint", ("new-password-errors" if user.errors[:password].any?) ].compact.join(" ") } %>
      <p id="new-password-hint" class="rc-field-hint"><%= t("ui.password_hint") %></p>
      <% if user.errors[:password].any? %>
        <ul id="new-password-errors" class="auth-field-errors">
          <% signup_password_errors(user, :password).each do |message| %><li><%= message %></li><% end %>
        </ul>
      <% end %>
    </div>
    <div class="rc-form-field">
      <%= form.label :password_confirmation, "Confirm New Password", class: "form-label" %>
      <%= form.password_field :password_confirmation, value: nil, required: true, autocomplete: "new-password", class: "form-control",
            aria: { invalid: user.errors[:password_confirmation].any?, describedby: ("new-password-confirmation-errors" if user.errors[:password_confirmation].any?) } %>
      <% if user.errors[:password_confirmation].any? %>
        <ul id="new-password-confirmation-errors" class="auth-field-errors">
          <% user.errors[:password_confirmation].each do |message| %><li><%= message %></li><% end %>
        </ul>
      <% end %>
    </div>
  </div>
  <div class="rc-form-footer"><%= form.submit "Change Password", class: "rc-btn rc-btn-primary" %></div>
<% end %>
