<main class="rc-page rc-settings">
  <div class="rc-page-heading"><div><span class="rc-kicker"><%= t("ui.settings_kicker") %></span><h1><%= t("ui.settings") %></h1><p><%= t("ui.settings_intro") %></p></div><%= link_to t("ui.back_dashboard"), dashboard_path, class: "rc-btn rc-btn-outline" %></div>
  <%= tag.div(flash[:notice], class: "rc-alert", role: "status") if flash[:notice] %>
  <%= render "shared/form_errors", record: Current.user %>
  <div class="rc-settings-layout"><nav class="rc-settings-nav" aria-label="<%= t('ui.settings_navigation') %>"><a href="#account" class="active"><%= t("ui.account_details") %></a><% if Rails.configuration.x.reminder_emails_enabled %><a href="#reminders"><%= t("ui.reminder_preferences") %></a><% end %><a href="#security"><%= t("ui.account_security") %></a><a href="#coming-later"><%= t("ui.coming_later") %></a></nav><div class="rc-settings-sections">
    <section id="account" class="card rc-setting-panel"><div class="rc-setting-head"><div><h2><%= t("ui.account_details") %></h2><p><%= t("ui.account_details_intro") %></p></div><span class="rc-tag"><%= t("ui.current_account") %></span></div><div class="rc-profile-line"><span class="rc-profile-avatar"><%= Current.user.email_address.first.upcase %></span><div><strong><%= t("ui.account_name") %></strong><span><%= Current.user.email_address %></span></div></div><div class="rc-setting-field"><label for="rc-email"><%= t("ui.email_address") %></label><input id="rc-email" class="form-control rc-input" type="email" value="<%= Current.user.email_address %>" readonly><small><%= t("ui.email_readonly") %></small></div></section>
    <% if Rails.configuration.x.reminder_emails_enabled %>
    <section id="reminders" class="card rc-setting-panel"><div class="rc-setting-head"><div><h2><%= t("ui.reminder_preferences") %></h2><p>We email you once before a purchase's return-by date.</p></div></div>
      <%= form_with model: Current.user, url: settings_path, method: :patch, class: "rc-setting-field" do |form| %>
        <%= form.label :reminder_days_before, "Remind me" %>
        <%= form.select :reminder_days_before, User::REMINDER_OPTIONS, {}, class: "form-select" %>
        <%= form.submit "Save settings", class: "rc-btn rc-btn-primary rc-btn-small" %>
      <% end %>
    </section>
    <% end %>
    <section id="security" class="card rc-setting-panel"><div class="rc-setting-head"><div><h2><%= t("ui.account_security") %></h2><p><%= t("ui.security_intro") %></p></div></div><div class="rc-security-row"><span class="rc-setting-icon" aria-hidden="true">⌑</span><div><strong><%= t("ui.change_password") %></strong><span><%= t("ui.password_pending") %></span></div><span class="rc-tag rc-tag-muted"><%= t("ui.not_available_yet") %></span></div></section>
    <section id="coming-later" class="card rc-setting-panel"><div class="rc-setting-head"><div><h2><%= t("ui.coming_later") %></h2><p><%= t("ui.settings_pending") %></p></div><span class="rc-tag rc-tag-muted"><%= t("ui.unavailable") %></span></div><div class="rc-coming-grid"><% unless Rails.configuration.x.reminder_emails_enabled %><div><span><%= t("ui.reminder_preferences") %></span><small><%= t("ui.planned") %></small></div><% end %><div><span><%= t("ui.personalization") %></span><small><%= t("ui.planned") %></small></div></div><p class="rc-setting-note"><%= t("ui.settings_note") %></p></section>
  </div></div>
</main>
