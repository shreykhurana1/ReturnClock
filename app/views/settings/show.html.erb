<main class="rc-page rc-settings">
  <div class="rc-page-heading">
    <div>
      <span class="rc-kicker"><%= t("ui.settings_kicker") %></span>
      <h1><%= t("ui.settings") %></h1>
      <p><%= t("ui.settings_intro") %></p>
    </div>
    <%= link_to t("ui.back_dashboard"), dashboard_path, class: "rc-btn rc-btn-outline" %>
  </div>
  <%= tag.div(flash[:notice], class: "rc-alert", role: "status") if flash[:notice] %>
  <%= tag.div(flash[:alert], class: "rc-alert", role: "alert") if flash[:alert] %>

  <div class="rc-settings-layout">
    <nav class="rc-settings-nav" aria-label="<%= t('ui.settings_navigation') %>" data-controller="rc-settings-navigation" data-action="click->rc-settings-navigation#activate hashchange@window->rc-settings-navigation#sync">
      <a href="#account" class="active"><%= t("ui.account_details") %></a>
      <a href="#alerts"><%= t("ui.deadline_alerts") %></a>
      <a href="#security"><%= t("ui.account_security") %></a>
    </nav>
    <div class="rc-settings-sections">
      <section id="account" class="card rc-setting-panel" aria-labelledby="rc-account-heading">
        <div class="rc-setting-head">
          <div>
            <h2 id="rc-account-heading"><%= t("ui.account_details") %></h2>
            <p><%= t("ui.account_details_intro") %></p>
          </div>
        </div>
        <div class="rc-profile-line">
          <span class="rc-profile-avatar" aria-hidden="true"><%= Current.user.email_address.first.upcase %></span>
          <div>
            <strong><%= t("ui.account_name") %></strong>
            <span><%= Current.user.email_address %></span>
          </div>
        </div>
        <div class="rc-setting-field">
          <label for="rc-email"><%= t("ui.email_address") %></label>
          <input id="rc-email" class="form-control rc-input" type="email" value="<%= Current.user.email_address %>" readonly>
          <small><%= t("ui.email_readonly") %></small>
        </div>
      </section>

      <section id="alerts" class="card rc-setting-panel" aria-labelledby="rc-alerts-heading">
        <div class="rc-setting-head">
          <div>
            <h2 id="rc-alerts-heading"><%= t("ui.deadline_alerts") %></h2>
            <p><%= Rails.configuration.x.reminder_emails_enabled ? t("ui.deadline_alerts_intro_email") : t("ui.deadline_alerts_intro") %></p>
          </div>
        </div>
        <%= form_with model: Current.user, url: settings_path, method: :patch, class: "rc-setting-field", data: { controller: "rc-error-focus" } do |form| %>
          <%= form.label :reminder_days_before, t("ui.alert_me") %>
          <%= form.select :reminder_days_before, User::REMINDER_OPTIONS, {}, class: "form-select",
                aria: { invalid: Current.user.errors[:reminder_days_before].any?, describedby: ("alert-preference-errors" if Current.user.errors[:reminder_days_before].any?) } %>
          <% if Current.user.errors[:reminder_days_before].any? %>
            <ul id="alert-preference-errors" class="auth-field-errors" role="alert">
              <li>Choose an alert preference from the available options.</li>
            </ul>
          <% end %>
          <%= form.submit t("ui.save_settings"), class: "rc-btn rc-btn-primary rc-btn-small", data: { turbo_submits_with: "Saving…" } %>
        <% end %>
      </section>

      <section id="security" class="card rc-setting-panel" aria-labelledby="rc-security-heading">
        <div class="rc-setting-head">
          <div>
            <h2 id="rc-security-heading"><%= t("ui.account_security") %></h2>
            <p><%= t("ui.security_intro") %></p>
          </div>
        </div>
        <%= render "settings/password_form", user: @user || Current.user %>
      </section>

    </div>
  </div>
</main>
