<% if !purchase.persisted? && !purchase_preview_enabled? %>
  <%= link_to t("ui.edit"), new_purchase_path(sample: purchase.item_name), class: "rc-btn rc-btn-outline", data: { turbo_frame: "purchase_editor" }, aria: { label: t("ui.edit_item", item: purchase.item_name) } %>
<% else %>
<% if purchase.persisted? && respond_to?(:edit_purchase_path) %>
  <%= link_to t("ui.edit"), edit_purchase_path(purchase), class: "rc-btn rc-btn-outline", data: { turbo_frame: "purchase_editor" }, aria: { label: t("ui.edit_item", item: purchase.item_name) } %>
<% else %>
  <button type="button" class="rc-btn rc-btn-outline" data-action="rc-purchase-preview#edit" aria-label="<%= t('ui.edit_item', item: purchase.item_name) %>"><%= t("ui.edit") %></button>
<% end %>
  <% if purchase.persisted? && respond_to?(:purchase_path) %>
  <details class="rc-card-more" data-controller="rc-card-more" data-action="click@document->rc-card-more#dismiss">
    <summary class="rc-btn rc-btn-outline rc-status-trigger" aria-label="<%= t("ui.update_status") %>: <%= purchase.item_name %>"><%= t("ui.update_status") %></summary>
    <div class="rc-card-more-panel">
      <%# Use the same allowed statuses as Edit Purchase; submit only the status field. %>
      <% status_options = Purchase::STATUSES.map { |state| [status_names.fetch(state), state] } %>
      <%= form_with(url: purchase_path(purchase), method: :patch, scope: :purchase, namespace: dom_id(purchase, :status), class: "rc-status-mini-form", local: true) do |form| %>
        <%= form.label :status, t("ui.update_status"), class: "form-label" %>
        <%= form.select :status, status_options, { selected: purchase.status, include_blank: false }, { class: "form-select" } %>
        <%= form.submit t("ui.confirm_status"), class: "rc-btn rc-btn-primary rc-btn-small" %>
      <% end %>
    </div>
  </details>
  <%= link_to "Delete", confirm_delete_purchase_path(purchase), class: "rc-btn rc-btn-outline rc-btn-danger", data: { turbo_frame: "purchase_editor" } %>
  <% else %>
    <button type="button" class="rc-btn rc-btn-outline rc-status-trigger" data-action="rc-purchase-preview#status"><%= t("ui.update_status") %></button>
    <button type="button" class="rc-btn rc-btn-outline rc-btn-danger" data-action="rc-purchase-preview#delete">Delete</button>
  <% end %>
<% end %>
