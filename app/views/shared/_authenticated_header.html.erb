<header class="app-header">
  <nav aria-label="Main navigation">
    <%= link_to "ReturnClock", dashboard_path, class: "app-brand" %>
    <%= link_to "Dashboard", dashboard_path, aria: { current: ("page" if current_page?(dashboard_path)) } %>
    <%= link_to "History", history_path, aria: { current: ("page" if current_page?(history_path)) } %>
    <%= link_to "Add Purchase", new_purchase_path %>
    <%= link_to "Store Policies", store_policies_path, aria: { current: ("page" if current_page?(store_policies_path)) } %>
    <details class="profile-menu">
      <summary aria-label="Profile menu"><span aria-hidden="true">&#128100;</span></summary>
      <div class="profile-menu-content">
        <p class="profile-account-label">Account</p>
        <p class="auth-hint"><%= Current.user.email_address %></p>
        <hr class="profile-menu-divider">
        <p><%= link_to settings_path do %><span class="profile-settings-icon" aria-hidden="true"></span>Account Settings<% end %></p>
        <%= button_to session_path, method: :delete, class: "auth-button" do %><span class="profile-logout-icon" aria-hidden="true"></span>Sign Out<% end %>
      </div>
    </details>
  </nav>
</header>
